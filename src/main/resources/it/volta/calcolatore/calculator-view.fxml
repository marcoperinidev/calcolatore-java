<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.TextField?>
<VBox
        alignment="CENTER"
        spacing="10.0"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="it.volta.calcolatore.CalculatorController">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <StackPane prefHeight="80.0">

        <TextField
                fx:id="display"
                text="0"
                editable="false"
                focusTraversable="false"
                mouseTransparent="true"
                alignment="CENTER_RIGHT"
                maxWidth="Infinity"
                maxHeight="Infinity"
                styleClass="display"/>

        <Pane
                mouseTransparent="true"
                maxWidth="Infinity"
                maxHeight="Infinity"
                styleClass="display-glass"/>

    </StackPane>

    <GridPane
            hgap="4.0"
            vgap="4.0"
            VBox.vgrow="ALWAYS">

        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints percentHeight="20"/>
            <RowConstraints percentHeight="20"/>
            <RowConstraints percentHeight="20"/>
            <RowConstraints percentHeight="20"/>
            <RowConstraints percentHeight="20"/>
        </rowConstraints>

        <Button text="7" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Button text="8" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button text="9" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Button text="÷" onAction="#onOperatorClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Button text="4" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Button text="5" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button text="6" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <Button text="×" onAction="#onOperatorClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Button text="1" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Button text="2" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button text="3" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <Button text="-" onAction="#onOperatorClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <Button text="C" onAction="#onOperatorClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Button text="0" onAction="#onNumberClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Button text="." maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <!-- onAction="#onDecimalClick" -->
        <Button text="+" onAction="#onOperatorClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="3" GridPane.rowIndex="3"/>

        <Button text="=" onAction="#onOperatorClick" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.columnIndex="0"
                GridPane.rowIndex="4"
                GridPane.columnSpan="4"/>

    </GridPane>

</VBox>
